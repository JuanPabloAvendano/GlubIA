# ==========================================================================
#  Caddy: sirve el portafolio y hace de unica puerta hacia GlubIA.
#
#  :8080  portafolio publico. De GlubIA solo expone dos rutas:
#           /api/preguntar  ->  /v1/public/ask
#           /api/info       ->  /v1/public/info
#         Todo lo demas son archivos estaticos de ./sitio.
#  :8081  GlubIA privado completo (tu UI + API v1). Solo LAN/localhost, o por
#         el tunel con Cloudflare Access delante.
#
#  HTTPS lo pone Cloudflare en el borde (tunel); dentro del equipo es http.
# ==========================================================================
{
	admin off
	auto_https off
	servers {
		# Solo cloudflared (IP fija en compose.yaml) puede decir quien es el
		# visitante. Un equipo de la LAN que envie CF-Connecting-IP no cuela.
		trusted_proxies static 172.30.0.10/32
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

(cabeceras) {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

(hacia_glubia) {
	# Sin flush_interval: Caddy ya envia al momento las respuestas text/event-stream
	# (SSE). Con "flush_interval -1", Caddy 2.6 no avisaba a GlubIA cuando el visitante
	# abandonaba una peticion SIN streaming y el modelo seguia trabajando para nadie.
	reverse_proxy glubia:11434 {
		# Caddy SOBRESCRIBE X-Real-IP: GlubIA solo la acepta de esta IP
		# (GLUBIA_PROXIES) para sus limites por visitante.
		header_up X-Real-IP {client_ip}
	}
}

:8080 {
	import cabeceras
	@estaticos path *.css *.js *.svg *.png *.jpg *.jpeg *.webp *.woff2 *.pdf

	# Solo los metodos que usa la pagina. Con cualquier otro (PUT, DELETE, TRACE...)
	# la peticion no llega a GlubIA: cae en los archivos estaticos (404).
	@preguntar {
		path /api/preguntar
		method POST OPTIONS
	}
	@info {
		path /api/info
		method GET OPTIONS
	}

	handle @preguntar {
		rewrite * /v1/public/ask
		import hacia_glubia
	}

	handle @info {
		rewrite * /v1/public/info
		import hacia_glubia
	}

	handle {
		root * /srv/portafolio
		encode zstd gzip
		# La politica de contenido completa va en cada HTML (la calcula construir.py segun
		# lo que la pagina usa: videos, audios, API en otro dominio...). Aqui solo lo que
		# no se puede poner en un <meta>.
		header Content-Security-Policy "frame-ancestors 'none'"
		header @estaticos Cache-Control "public, max-age=3600"
		file_server
	}

	# Rutas inexistentes: la 404 del sitio (usa rutas absolutas, vale para /lo/que/sea).
	handle_errors {
		@no_existe expression {err.status_code} == 404
		handle @no_existe {
			root * /srv/portafolio
			header Content-Security-Policy "frame-ancestors 'none'"
			rewrite * /404.html
			file_server
		}
		respond "{err.status_code} {err.status_text}"
	}
}

:8081 {
	import cabeceras
	import hacia_glubia
}
