# ==========================================================================
#  Copia este archivo a .env y ajustalo.  NUNCA subas .env a git.
#  scripts/instalar-omarchy.sh lo crea y rellena lo detectable por ti.
# ==========================================================================

# --- Imagen -----------------------------------------------------------------
# La publica el pipeline en GitHub Container Registry (siempre en minusculas).
# GLUBIA_TAG la mueve scripts/desplegar.sh.
GLUBIA_IMAGEN=ghcr.io/juanpabloavendano/glubia
GLUBIA_TAG=latest
# Para scripts/actualizar-auto.sh (despliegue automatico de nuevas versiones)
GLUBIA_REPO=JuanPabloAvendano/GlubIA

# --- Variantes de compose ----------------------------------------------------
# GPU Intel (por defecto):  compose.yaml
# Solo CPU:                 compose.yaml:compose.cpu.yaml
# Windows + WSL2:           compose.yaml:compose.wsl.yaml
COMPOSE_FILE=compose.yaml

# GID del grupo que es duenio de /dev/dri/renderD128 en este equipo:
#   stat -c %g /dev/dri/renderD128
RENDER_GID=989

# --- Modelo ------------------------------------------------------------------
# Carpeta de modelos en el anfitrion y subcarpeta del modelo activo.
GLUBIA_MODELOS=./modelos
GLUBIA_MODELO_DIR=qwen2.5-coder-7b-int4-ov
GLUBIA_DEVICE=GPU
GLUBIA_MEM=12g
# auto distingue solo entre modelos de texto (LLM) y con vision (VLM, p. ej. Gemma 4).
GLUBIA_PIPELINE=auto
# Propiedades extra de OpenVINO en JSON. Ejemplos:
#   ahorrar memoria en contextos largos:  {"KV_CACHE_PRECISION":"u8"}
#   NPU (con GLUBIA_DEVICE=NPU):          {"MAX_PROMPT_LEN":2048,"MIN_RESPONSE_LEN":512}
GLUBIA_OV_CONFIG=
# Contexto extra para la plantilla del modelo. Vacio = automatico (desactiva el
# "razonamiento" de Qwen3/Qwen3.5 para responder directo).
GLUBIA_PLANTILLA_EXTRA=

# --- Acceso privado ----------------------------------------------------------
# Contrasena de la UI. Usa una larga:  openssl rand -base64 18
GLUBIA_PASS=cambia-esta-clave
GLUBIA_HORAS=8
# Claves de API directas (opcional, separadas por comas). Mejor crearlas con:
#   docker compose exec glubia python -m glubia.claves crear NOMBRE
GLUBIA_API_KEYS=

# --- Limites de generacion -------------------------------------------------
GLUBIA_CTX=8192
GLUBIA_MAX_TOKENS=4096
GLUBIA_MAX_SEG=300
GLUBIA_COLA=8

# --- Asistente publico del portafolio ---------------------------------------
GLUBIA_PUBLICO=1
# Procesa la persona al cargar el modelo: el primer visitante no espera ~50 s (CPU) a que lea el perfil
GLUBIA_PRECALENTAR=1
GLUBIA_PUBLICO_TOKENS=350
GLUBIA_PUBLICO_RPM=6
GLUBIA_PUBLICO_DIA=80
GLUBIA_PUBLICO_COLA=3
# Solo hace falta si el portafolio se sirve desde OTRO dominio (p. ej.
# Cloudflare Pages) y llama a la API por https://ia.tu-dominio.com
GLUBIA_CORS=

# --- Buzon (enviarte archivos con verificacion de identidad) -----------------
# Necesita la verificacion en dos pasos:
#   docker compose exec glubia python -m glubia.identidad activar
GLUBIA_BUZON=1
GLUBIA_BUZON_HOST=./buzon          # carpeta del equipo donde quedan los archivos
GLUBIA_BUZON_MAX_MB=10240          # maximo por archivo
GLUBIA_BUZON_CUOTA_GB=100          # maximo total
GLUBIA_BUZON_RESERVA_GB=10         # espacio libre que nunca se toca
GLUBIA_BUZON_PARTE_MB=8            # tamano de cada parte (Cloudflare corta a los 100 MB)

# --- Red --------------------------------------------------------------------
# 127.0.0.1 = solo este equipo (el tunel no necesita mas).
# 0.0.0.0   = tambien la LAN (y abre el firewall: ver docs/OMARCHY.md).
WEB_BIND=127.0.0.1
PUERTO_PORTAFOLIO=8080
PUERTO_PRIVADO=8081

# --- Tunel Cloudflare (docker compose --profile tunel up -d) ----------------
CF_TUNNEL_TOKEN=
