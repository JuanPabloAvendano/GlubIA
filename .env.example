# ==========================================================================
#  Copia este archivo a .env y ajustalo.  NUNCA subas .env a git.
#  scripts/instalar-omarchy.sh lo crea y rellena lo detectable por ti.
# ==========================================================================

# --- Imagen -----------------------------------------------------------------
# La publica el pipeline en GitHub Container Registry. Cambia "cambia-esto"
# por tu usuario de GitHub. GLUBIA_TAG la mueve scripts/desplegar.sh.
GLUBIA_IMAGEN=ghcr.io/cambia-esto/glubia
GLUBIA_TAG=latest

# --- Variantes de compose ----------------------------------------------------
# GPU Intel (por defecto):  compose.yaml
# Solo CPU:                 compose.yaml:compose.cpu.yaml
# Windows + WSL2:           compose.yaml:compose.wsl.yaml
COMPOSE_FILE=compose.yaml

# GID del grupo que es duenio de /dev/dri/renderD128 en este equipo:
#   stat -c %g /dev/dri/renderD128
RENDER_GID=989

# --- Modelo ------------------------------------------------------------------
# Carpeta de modelos en el anfitrion y subcarpeta del modelo activo.
GLUBIA_MODELOS=./modelos
GLUBIA_MODELO_DIR=qwen2.5-coder-7b-int4-ov
GLUBIA_DEVICE=GPU
GLUBIA_MEM=12g

# --- Motor -------------------------------------------------------------------
# openvino = modelo OpenVINO de GLUBIA_MODELOS/GLUBIA_MODELO_DIR (por defecto)
# ollama   = cualquier modelo de ollama.com; activa tambien el perfil ollama
#            (COMPOSE_PROFILES=ollama, o anadelo a los que ya tengas con comas)
GLUBIA_MOTOR=openvino
# Cambiar de modelo con Ollama:
#   docker compose exec ollama ollama pull huihui_ai/qwen2.5-coder-abliterate:7b
#   GLUBIA_OLLAMA_MODELO=huihui_ai/qwen2.5-coder-abliterate:7b   y   docker compose up -d
GLUBIA_OLLAMA_MODELO=huihui_ai/qwen3.5-abliterated:4B
# Carpeta de modelos de Ollama en el anfitrion (puede ser tu ~/.ollama/models).
OLLAMA_MODELOS=./modelos/ollama
# -1 = el modelo se queda siempre en memoria; "30m" lo libera tras 30 min sin uso.
GLUBIA_OLLAMA_KEEP=-1
# 1 = deja "pensar" a los modelos que razonan (Qwen3.5): mejor, pero mas lento.
GLUBIA_OLLAMA_PENSAR=0
OLLAMA_MEM=10g
# OLLAMA_GPU=1 deja la GPU Intel disponible para Ollama (Vulkan); 0 la oculta del todo.
# GLUBIA_OLLAMA_GPU es solo el valor inicial de «GPU en Ollama»: luego se cambia
# desde el panel de admin. En un Core Ultra 5 115U (Meteor Lake) la CPU fue mas
# rapida con el 4B (5,8 vs 3,4 tok/s).
OLLAMA_GPU=1
GLUBIA_OLLAMA_GPU=0

# --- Acceso privado ----------------------------------------------------------
# Contrasena de la UI. Usa una larga:  openssl rand -base64 18
GLUBIA_PASS=cambia-esta-clave
GLUBIA_HORAS=8
# Claves de API directas (opcional, separadas por comas). Mejor crearlas con:
#   docker compose exec glubia python -m glubia.claves crear NOMBRE
GLUBIA_API_KEYS=

# --- Limites de generacion -------------------------------------------------
GLUBIA_CTX=8192
GLUBIA_MAX_TOKENS=4096
GLUBIA_MAX_SEG=300
GLUBIA_COLA=8

# --- Red --------------------------------------------------------------------
# 127.0.0.1 = solo este equipo (el tunel no necesita mas).
# 0.0.0.0   = tambien la LAN (y abre el firewall: ver docs/OMARCHY.md).
WEB_BIND=127.0.0.1
PUERTO_PRIVADO=8081

# --- Tunel Cloudflare (docker compose --profile tunel up -d) ----------------
CF_TUNNEL_TOKEN=

# --- Tuneles rapidos sin cuenta (trycloudflare.com) ----------------------------
# Con esto, `docker compose up -d` (y cada arranque del equipo) abre un tunel
# a la UI privada. La URL la muestra scripts/vigilar.sh.
# Dejalo vacio si usas el tunel con tu dominio (CF_TUNNEL_TOKEN).
# COMPOSE_PROFILES=tunel-rapido
